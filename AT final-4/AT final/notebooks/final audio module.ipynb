# CELL 12 — INFERENCE FUNCTION
# Called by your Flask/FastAPI REST endpoint
# =============================================================

def predict_audio(wav_path,
                  hate_model_path="/kaggle/working/model_hate_speech",
                  fake_model_path="/kaggle/working/model_deepfake"):
    """
    Run both models on one audio file.

    Returns:
    {
        "hate_speech"            : True / False,
        "hate_label"             : "OFF" / "NOT",
        "hate_confidence"        : 0.0 - 1.0,
        "audio_authentic"        : True / False,
        "authenticity_label"     : "REAL" / "FAKE",
        "authenticity_confidence": 0.0 - 1.0,
    }
    """
    audio   = load_audio(wav_path)
    output  = {}

    # Hate model
    h_proc  = Wav2Vec2Processor.from_pretrained(hate_model_path)
    h_model = Wav2Vec2ForSequenceClassification.from_pretrained(hate_model_path)
    h_model.eval().to(DEVICE)
    inp = h_proc(audio, sampling_rate=SAMPLE_RATE, return_tensors="pt")
    with torch.no_grad():
        logits = h_model(input_values=inp["input_values"].to(DEVICE)).logits
    pred  = torch.argmax(logits, dim=1).item()
    probs = torch.softmax(logits, dim=1).cpu().numpy()[0]
    output["hate_speech"]     = bool(pred == 1)
    output["hate_label"]      = "OFF" if pred == 1 else "NOT"
    output["hate_confidence"] = float(probs[pred])
    del h_model, h_proc
    torch.cuda.empty_cache()

    # Fake model
    f_proc  = Wav2Vec2Processor.from_pretrained(fake_model_path)
    f_model = Wav2Vec2ForSequenceClassification.from_pretrained(fake_model_path)
    f_model.eval().to(DEVICE)
    inp = f_proc(audio, sampling_rate=SAMPLE_RATE, return_tensors="pt")
    with torch.no_grad():
        logits = f_model(input_values=inp["input_values"].to(DEVICE)).logits
    pred  = torch.argmax(logits, dim=1).item()
    probs = torch.softmax(logits, dim=1).cpu().numpy()[0]
    output["audio_authentic"]       = bool(pred == 0)
    output["authenticity_label"]    = "REAL" if pred == 0 else "FAKE"
    output["authenticity_confidence"] = float(probs[pred])
    del f_model, f_proc
    torch.cuda.empty_cache()

    return output


