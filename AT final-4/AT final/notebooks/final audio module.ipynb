from IPython.display import FileLink, display
 
def zip_and_download(model_dir, zip_name):
    """
    Zip a saved model folder and make it downloadable.
    model_dir : path to the saved model folder
    zip_name  : name for the zip file (without .zip)
    """
    zip_path = f"/kaggle/working/{zip_name}"
 
    # Create zip
    shutil.make_archive(zip_path, 'zip', model_dir)
    full_zip = zip_path + ".zip"
 
    size_mb = os.path.getsize(full_zip) / (1024 * 1024)
    print(f"Created: {full_zip}  ({size_mb:.1f} MB)")
 
    # Show download link
    display(FileLink(full_zip, result_html_prefix=f"Download {zip_name}: "))
    return full_zip
 
 
