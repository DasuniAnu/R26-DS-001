# =============================================================
# CELL 6 — PYTORCH DATASET CLASS
# =============================================================

class AudioDataset(Dataset):
    def __init__(self, df, processor, max_length=MAX_LENGTH):
        self.filepaths  = df["filepath"].tolist()
        self.labels     = df["label_num"].tolist()
        self.filenames  = df["filename"].tolist()
        self.processor  = processor
        self.max_length = max_length

    def __len__(self):
        return len(self.filepaths)

    def __getitem__(self, idx):
        audio = load_audio(self.filepaths[idx], self.max_length)

        inputs = self.processor(
            audio,
            sampling_rate = SAMPLE_RATE,
            return_tensors = "pt",
            padding        = True,
            max_length     = self.max_length,
            truncation     = True,
        )

        return {
            "input_values" : inputs["input_values"].squeeze(),
            "labels"       : torch.tensor(self.labels[idx], dtype=torch.long),
        }




# =============================================================
# CELL 7 — METRICS
# =============================================================

def compute_metrics(eval_pred):
    logits, labels = eval_pred
    preds = np.argmax(logits, axis=1)
    probs = torch.softmax(
        torch.tensor(logits, dtype=torch.float), dim=1
    ).numpy()[:, 1]

    acc      = accuracy_score(labels, preds)
    macro_f1 = f1_score(labels, preds, average="macro", zero_division=0)
    try:
        auc = roc_auc_score(labels, probs)
    except ValueError:
        auc = 0.0

    return {"accuracy": acc, "macro_f1": macro_f1, "roc_auc": auc}




# =============================================================
# CELL 8 — TRAINING FUNCTION
# =============================================================

def train_audio_model(
    task_name,
    train_df,
    test_df,
    id2label,
    label2id,
    freeze_encoder = True,
    num_epochs     = 15,
    batch_size     = 4,
    learning_rate  = 1e-4,
):
    import shutil

    print(f"\n{'='*60}")
    print(f"TRAINING : {task_name}")
    print(f"Train    : {len(train_df)} files")
    print(f"Test     : {len(test_df)} files")
    print(f"Encoder  : {'FROZEN' if freeze_encoder else 'UNFROZEN'}")
    print(f"{'='*60}")

    processor = Wav2Vec2Processor.from_pretrained(MODEL_NAME)
    model = Wav2Vec2ForSequenceClassification.from_pretrained(
        MODEL_NAME,
        num_labels              = 2,
        id2label                = id2label,
        label2id                = label2id,
        hidden_dropout          = 0.3,
        feat_proj_dropout       = 0.1,
        attention_dropout       = 0.1,
        classifier_proj_size    = 256,
        ignore_mismatched_sizes = True,
    )

    # Freeze encoder — only classifier head trains
    # Essential at 30-60 samples to prevent overfitting
    if freeze_encoder:
        for param in model.wav2vec2.parameters():
            param.requires_grad = False
        trainable = sum(p.numel() for p in model.parameters() if p.requires_grad)
        total     = sum(p.numel() for p in model.parameters())
        print(f"Trainable: {trainable:,} / {total:,} params")

    train_dataset = AudioDataset(train_df, processor)
    test_dataset  = AudioDataset(test_df,  processor)

    tmp_dir = f"/tmp/audio_{task_name}"
    training_args = TrainingArguments(
        output_dir                  = tmp_dir,
        num_train_epochs            = num_epochs,
        per_device_train_batch_size = batch_size,
        per_device_eval_batch_size  = batch_size * 2,
        learning_rate               = learning_rate,
        warmup_ratio                = 0.1,
        weight_decay                = 0.01,
        eval_strategy               = "epoch",
        save_strategy               = "no",
        logging_steps               = 5,
        fp16                        = torch.cuda.is_available(),
        report_to                   = "none",
        dataloader_num_workers      = 0,
        remove_unused_columns       = False,
    )

    trainer = Trainer(
        model           = model,
        args            = training_args,
        train_dataset   = train_dataset,
        eval_dataset    = test_dataset,
        compute_metrics = compute_metrics,
    )

    trainer.train()
    results = trainer.evaluate()

    # ── Per-sample predictions on test set ───────────────────
    print(f"\n{task_name} — FINAL RESULTS")
    print(f"  Accuracy : {results['eval_accuracy']:.4f}")
    print(f"  Macro-F1 : {results['eval_macro_f1']:.4f}")
    print(f"  ROC-AUC  : {results['eval_roc_auc']:.4f}")

    # Classification report + confusion matrix
    model.eval()
    model.to(DEVICE)
    all_preds, all_labels = [], []

    with torch.no_grad():
        for i in range(len(test_dataset)):
            batch      = test_dataset[i]
            input_vals = batch["input_values"].unsqueeze(0).to(DEVICE)
            label      = batch["labels"].item()
            logits     = model(input_values=input_vals).logits
            pred       = torch.argmax(logits, dim=1).item()
            all_preds.append(pred)
            all_labels.append(label)
            # Show filename + prediction for each test sample
            fname = test_df.iloc[i]["filename"]
            true_lbl = id2label[label]
            pred_lbl = id2label[pred]
            status   = "✓" if pred == label else "✗"
            print(f"  {status} {fname:<25} True:{true_lbl}  Pred:{pred_lbl}")

    print(f"\n{task_name} — CLASSIFICATION REPORT")
    print(classification_report(
        all_labels, all_preds,
        target_names=list(id2label.values()),
        zero_division=0
    ))
    print("Confusion Matrix:")
    print(confusion_matrix(all_labels, all_preds))
    print(f"  Rows=Actual, Cols=Predicted")
    print(f"  Labels: {list(id2label.values())}")

    # Save model
    save_path = f"/kaggle/working/model_{task_name}"
    model.save_pretrained(save_path)
    processor.save_pretrained(save_path)
    print(f"\nSaved → {save_path}")

    # Cleanup
    if os.path.exists(tmp_dir):
        shutil.rmtree(tmp_dir)
    del model, trainer, train_dataset, test_dataset
    gc.collect()
    torch.cuda.empty_cache()

    return results



