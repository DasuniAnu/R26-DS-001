{
  "manifest_version": 3,
  "name": "TruthLenseAI — Hate Speech & False Content Checker",
  "version": "0.1.0",
  "description": "Check the current YouTube video for Tamil/Sinhala hate speech, Sinhala audio deepfakes, and Sinhala false content using your local TruthLenseAI backends.",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtu.be/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:5002/*",
    "http://localhost:5002/*",
    "http://127.0.0.1:5003/*",
    "http://localhost:5003/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TruthLenseAI — Check this video"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtu.be/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
